# Copy to .env. docker compose loads this automatically.

# REQUIRED. The server refuses to bind off-loopback without it.
# Generate: openssl rand -hex 32
HEALTH_MCP_TOKEN=

# Where compose publishes the port on the host.
# Keep 127.0.0.1 unless you need LAN access (then 0.0.0.0 + a strong token).
HEALTH_MCP_BIND=127.0.0.1
HEALTH_MCP_HOST_PORT=7777

# Optional: timezone for date-bucket queries (IANA name, e.g. Europe/Madrid).
HEALTH_MCP_TZ=UTC

# Optional: serve the bundled dashboard SPA at /. Set "false" for a headless server.
HEALTH_MCP_DASHBOARD=true

# Optional: log verbosity (debug | info | warn | error).
HEALTH_MCP_LOG_LEVEL=info

# Optional: wearable OAuth redirect base — set to a tunnel URL when linking a provider
# from outside localhost (e.g. ngrok / Cloudflare Tunnel).
HEALTH_MCP_WEARABLE_REDIRECT_BASE=

# Optional: provider credentials.
HEALTH_MCP_USDA_API_KEY=
HEALTH_MCP_WHOOP_CLIENT_ID=
HEALTH_MCP_WHOOP_CLIENT_SECRET=
HEALTH_MCP_OURA_CLIENT_ID=
HEALTH_MCP_OURA_CLIENT_SECRET=
HEALTH_MCP_ZEPP_CLIENT_ID=
HEALTH_MCP_ZEPP_CLIENT_SECRET=
